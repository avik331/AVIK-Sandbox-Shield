{
  "boot-source": {
    "kernel_image_path": "vmlinux.bin",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off nomodules ipv6.disable=1 quiet",
    "initrd_path": null
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "rootfs.ext4",
      "is_root_device": true,
      "is_read_only": true,
      "cache_type": "Unsafe",
      "io_engine": "Sync"
    }
  ],
  "machine-config": {
    "vcpu_count": 4,
    "mem_size_mib": 16384,
    "smt": false,
    "track_dirty_pages": false
  },
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "host_dev_name": "tap0",
      "guest_mac": "AA:FC:00:00:00:01",
      "rx_rate_limiter": {
        "bandwidth": {
          "size": 12500000,
          "one_time_burst": 0,
          "refill_time": 100
        },
        "ops": {
          "size": 1000,
          "one_time_burst": 0,
          "refill_time": 100
        }
      },
      "tx_rate_limiter": {
        "bandwidth": {
          "size": 12500000,
          "one_time_burst": 0,
          "refill_time": 100
        },
        "ops": {
          "size": 1000,
          "one_time_burst": 0,
          "refill_time": 100
        }
      }
    }
  ]
}
